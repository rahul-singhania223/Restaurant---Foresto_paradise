---
import { Image } from "astro:assets";

interface NavItem {
  label: string;
  href: string;
}

const navItems: NavItem[] = [
  { label: "Home", href: "/" },
  { label: "Menu", href: "/menu" },
  // { label: "Locations", href: "/locations" },
  // { label: "Experience", href: "/experience" },
  // { label: "Events", href: "/events" },
  { label: "About", href: "/about" },
  { label: "Contact", href: "/contact" },
];

const currentPath = Astro.url.pathname;
---

<header
  class="absolute inset-x-0 top-0 z-50"
>
  <nav
    class="mx-auto flex h-[104px] max-w-[1720px] items-center px-6 sm:px-10 lg:px-8 xl:px-16"
    aria-label="Main navigation"
  >

    

    <!-- ============================================================
         DESKTOP NAVIGATION
         ============================================================ -->

    <div class="hidden items-center flex-1 lg:flex">

      <!-- ============================================================
         LOGO
         Replace this placeholder with your actual logo
         ============================================================ -->

         <div class="flex justify-start flex-1 ">

           <a
          href="/"
          area-label="Home"

          >
            <Image
              src="/images/logo.png"
              alt="Foresto-paradise-logo"
              class="w-48 rounded-full"
              width={500}
              height={500}
              quality={100}
              loading="eager"
              format="webp"
              />
          </a>
        
      </div>


      <div class="flex justify-center flex-1 items-center gap-8 xl:gap-9">
        {
          navItems.map((item) => {
            const isActive =
              item.href === "/"
                ? currentPath === "/"
                : currentPath.startsWith(item.href);

            return (
              <a
                href={item.href}
                class:list={[
                  "group relative py-2 text-[14px] font-medium transition-colors duration-200",
                  isActive
                    ? "text-white"
                    : "text-white/85 hover:text-white",
                ]}
                aria-current={isActive ? "page" : undefined}
              >
                {item.label}

                <!-- Active / hover underline -->
                <span
                  class:list={[
                    "absolute -bottom-1 left-0 h-px bg-[#c9c486] transition-all duration-300",
                    isActive
                      ? "w-full"
                      : "w-0 group-hover:w-full",
                  ]}
                ></span>
              </a>
            );
          })
        }
      </div>


      <!-- ============================================================
           ACTIONS
           ============================================================ -->

      <div class="flex flex-1 items-center gap-4 justify-end">

        <!-- Order Online -->
        <a
          href="/order"
          class="inline-flex h-[48px] items-center justify-center rounded-full border border-white/35 bg-black/10 px-6 text-[14px] font-medium text-white backdrop-blur-md transition-all duration-300 hover:border-white/60 hover:bg-white/10"
        >
          Order Online
        </a>


        <!-- Book a Table -->
        <button
          data-reservation-trigger
          class="inline-flex h-[48px] items-center justify-center rounded-full bg-[#b7b777] px-7 text-[14px] font-medium text-[#17190f] transition-all duration-300 hover:bg-[#cece8b] hover:shadow-[0_8px_30px_rgba(183,183,119,0.18)]"
        >
          Book a Table
      </button>

      </div>

    </div>


    <!-- ============================================================
         MOBILE MENU BUTTON
         ============================================================ -->

    <button
      id="mobile-menu-button"
      type="button"
      class="ml-auto flex h-11 w-11 items-center justify-center rounded-full border border-white/20 bg-black/20 text-white backdrop-blur-md lg:hidden"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
    >
      <svg
        viewBox="0 0 24 24"
        class="h-5 w-5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="M4 7h16" />
        <path d="M4 12h16" />
        <path d="M4 17h16" />
      </svg>
    </button>

  </nav>


  <!-- ================================================================
       MOBILE MENU
       ================================================================ -->

  <div
    id="mobile-menu"
    class="mx-4 hidden overflow-hidden rounded-2xl border border-white/10 bg-[#10130d]/95 shadow-2xl backdrop-blur-xl lg:hidden"
  >
    <div class="flex flex-col p-4">

      {
        navItems.map((item) => {
          const isActive =
            item.href === "/"
              ? currentPath === "/"
              : currentPath.startsWith(item.href);

          return (
            <a
              href={item.href}
              class:list={[
                "rounded-xl px-4 py-3.5 text-sm transition-colors",
                isActive
                  ? "bg-white/10 text-[#d1cb83]"
                  : "text-white/80 hover:bg-white/5 hover:text-white",
              ]}
            >
              {item.label}
            </a>
          );
        })
      }

      <div class="mt-3 grid grid-cols-2 gap-3 border-t border-white/10 pt-4">

        <a
          href="/order"
          class="flex h-12 items-center justify-center rounded-full border border-white/20 text-sm font-medium text-white"
        >
          Order Online
        </a>

        <button
          data-reservation-trigger
          
          class="flex h-12 items-center justify-center rounded-full bg-[#b7b777] text-sm font-medium text-[#17190f]"
        >
          Book a Table
      </button>

      </div>

    </div>
  </div>
</header>


<script>
  const menuButton = document.querySelector<HTMLButtonElement>(
    "#mobile-menu-button"
  );

  const mobileMenu = document.querySelector<HTMLElement>(
    "#mobile-menu"
  );

  menuButton?.addEventListener("click", () => {
    if (!mobileMenu) return;

    const isOpen = !mobileMenu.classList.contains("hidden");

    mobileMenu.classList.toggle("hidden");
    menuButton.setAttribute("aria-expanded", String(!isOpen));
    menuButton.setAttribute(
      "aria-label",
      isOpen ? "Open menu" : "Close menu"
    );
  });
</script>