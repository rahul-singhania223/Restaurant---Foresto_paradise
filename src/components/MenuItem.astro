---
import MenuItemModal from "./MenuItemModal.astro";

interface Props {
  name: string;
  description?: string;
  price: string;
  image: string;
  vegetarian?: boolean;
  spicy?: boolean;
  popular?: boolean;
  index?: number;
}

const {
  name,
  description,
  price,
  image,
  vegetarian = false,
  spicy = false,
  popular = false,
  index = 0,
} = Astro.props;

const modalId = name ? `menu-modal-${name
  .toLowerCase()
  .replace(/[^a-z0-9]+/g, "-")
  .replace(/(^-|-$)/g, "")}` : "";

---

<article
  class:list={[
    "menu-item group relative border-b border-[#deded5] py-7 sm:py-8",
    index === 0 ? "md:border-t" : "",
  ]}
  data-menu-item-trigger
  data-modal-id={`menu-modal-${index}`}
>
  <button
    type="button"
    class="block w-full cursor-pointer text-left"
    data-menu-item-trigger
    data-modal-id={modalId}
    aria-haspopup="dialog"
    aria-controls={modalId}
  >
    <div class="flex items-start justify-between gap-8">
      <!-- Dish information -->
      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2.5">
          <h3
            class="text-[16px] font-medium tracking-[-0.01em] text-[#20231c] transition-colors duration-300 group-hover:text-[#7d8054] sm:text-[17px]"
          >
            {name}
          </h3>

          <!-- Vegetarian -->
          {
            vegetarian && (
              <span
                class="flex h-4 w-4 items-center justify-center rounded-[3px] border border-[#71905c]"
                title="Vegetarian"
                aria-label="Vegetarian"
              >
                <span class="h-1.5 w-1.5 rounded-full bg-[#71905c]"></span>
              </span>
            )
          }

          <!-- Spicy -->
          {
            spicy && (
              <span
                class="text-[10px]"
                title="Spicy"
                aria-label="Spicy"
              >
                🌶
              </span>
            )
          }

          <!-- Popular -->
          {
            popular && (
              <span class="rounded-full bg-[#e9e8d9] px-2 py-1 text-[9px] font-medium uppercase tracking-[0.12em] text-[#777950]">
                Popular
              </span>
            )
          }
        </div>

        {
          description && (
            <p class="mt-2 max-w-[430px] text-[12px] leading-5 text-[#85867f] sm:text-[13px] sm:leading-6">
              {description}
            </p>
          )
        }
      </div>

      <!-- Price -->
      <div class="flex shrink-0 items-center gap-3 pt-0.5">
        <span class="text-[14px] font-medium text-[#34372e] sm:text-[15px]">
          {price}
        </span>

        <!-- Hover arrow -->
        <span
          class="flex h-7 w-7 items-center justify-center rounded-full border border-[#d8d8ce] text-[#777a69] opacity-0 -translate-x-1 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100"
          aria-hidden="true"
        >
          <svg
            viewBox="0 0 16 16"
            class="h-3.5 w-3.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.3"
          >
            <path d="M3 8h9" />
            <path d="m8 4 4 4-4 4" />
          </svg>
        </span>
      </div>
    </div>
  </button>

  <!-- Modal -->
  <MenuItemModal
    id={modalId}
    name={name}
    description={description}
    price={price}
    image={image}
    vegetarian={vegetarian}
    spicy={spicy}
    popular={popular}
  />
</article>