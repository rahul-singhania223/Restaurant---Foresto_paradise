---
const services = [
  {
    title: "Dining",
    description:
      "Everyday dining or special evenings, we set the perfect table for great food and good conversations.",
    action: "Explore Dining",
    href: "/menu",
    image: "https://images.unsplash.com/photo-1592861956120-e524fc739696?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
    icon: "dining",
  },
  {
    title: "Celebrations",
    description:
      "Make your special moments unforgettable with our warm ambiance, curated menus and thoughtful service.",
    action: "Plan a Celebration",
    href: "/events",
    image: "https://images.unsplash.com/photo-1517457373958-b7bdd4587205?q=80&w=1169&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
    icon: "gift",
  },
  {
    title: "Private Events",
    description:
      "From intimate gatherings to large celebrations, we create custom experiences tailored to you.",
    action: "Enquire Now",
    href: "/contact",
    image: "https://images.unsplash.com/photo-1528605248644-14dd04022da1?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
    icon: "people",
  },
  {
    title: "Corporate",
    description:
      "Host meetings, corporate dinners and team gatherings in a space designed for comfort and connection.",
    action: "Corporate Enquiry",
    href: "/contact",
    image: "https://images.unsplash.com/photo-1758518729685-f88df7890776?q=80&w=1331&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
    icon: "briefcase",
  },
];
---

<section
  id="services"
  class="services-section relative overflow-hidden bg-[#f2f2e4] text-[#20231b]"
>
  <!-- ============================================================
       BACKGROUND
       ============================================================ -->

  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_50%_0%,rgba(255,255,255,0.72),transparent_42%),radial-gradient(circle_at_10%_60%,rgba(214,217,192,0.22),transparent_35%),radial-gradient(circle_at_90%_70%,rgba(218,220,198,0.2),transparent_35%)]"
  ></div>

  <!-- subtle decorative texture -->
  <div
    class="pointer-events-none absolute left-1/2 top-0 -z-10 h-[420px] w-[900px] -translate-x-1/2 rounded-full bg-white/20 blur-[100px]"
  ></div>


  <!-- ============================================================
       MAIN CONTAINER
       ============================================================ -->

  <div
    class="mx-auto max-w-[1500px] px-5 py-20 sm:px-8 sm:py-24 lg:px-12 lg:py-28 xl:px-16"
  >

    <!-- ==========================================================
         SECTION HEADER
         ========================================================== -->

    <header class="mx-auto max-w-[850px] text-center">

      <!-- Eyebrow -->
      <div
        data-reveal
        class="flex items-center justify-center gap-3 text-[11px] font-medium uppercase tracking-[0.2em] text-[#687342] sm:text-xs"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-7 w-7"
          fill="none"
          stroke="currentColor"
          stroke-width="1.25"
          aria-hidden="true"
        >
          <path d="M12 21V8" />
          <path
            d="M12 12C8.5 12 6 9.5 6 6c3.5 0 6 2.5 6 6Z"
          />
          <path
            d="M12 15c3.5 0 6-2.5 6-9-3.5 0-6 2.5-6 6Z"
          />
        </svg>

        <span>Our Services</span>
      </div>


      <!-- Heading -->
      <h2
        data-reveal
        data-delay="100"
        class="mt-6 font-serif text-[clamp(3rem,6vw,5.2rem)] font-normal leading-[0.98] tracking-[-0.05em]"
      >
        Here for
        <span class="text-[#77824f]"> every occasion.</span>
      </h2>


      <!-- Decorative divider -->
      <div
        data-reveal
        data-delay="160"
        class="mt-7 flex items-center justify-center gap-4"
      >
        <span class="h-px w-12 bg-[#788450]/60"></span>

        <svg
          viewBox="0 0 24 24"
          class="h-5 w-5 text-[#788450]"
          fill="none"
          stroke="currentColor"
          stroke-width="1.25"
          aria-hidden="true"
        >
          <path d="M12 21V8" />
          <path
            d="M12 12C8.5 12 6 9.5 6 6c3.5 0 6 2.5 6 6Z"
          />
          <path
            d="M12 15c3.5 0 6-2.5 6-9-3.5 0-6 2.5-6 6Z"
          />
        </svg>

        <span class="h-px w-12 bg-[#788450]/60"></span>
      </div>


      <!-- Description -->
      <p
        data-reveal
        data-delay="220"
        class="mx-auto mt-7 max-w-[650px] text-[15px] leading-7 text-[#555950] sm:text-base sm:leading-8"
      >
        From cozy dinners to grand celebrations, we create
        experiences that bring people together.
      </p>

    </header>


    <!-- ==========================================================
         SERVICE CARDS
         ========================================================== -->

    <div
      class="mt-12 grid gap-6 sm:mt-14 sm:grid-cols-2 lg:grid-cols-4 lg:gap-5 xl:gap-6"
    >

      {
        services.map((service, index) => (
          <article
            data-reveal
            data-delay={String(280 + index * 100)}
            class="service-card group relative overflow-hidden rounded-[20px] border border-[#d8d9c9]/80 bg-[#f8f8ee]/90 shadow-[0_15px_40px_rgba(45,50,32,0.07)] transition-all duration-700 hover:-translate-y-2 hover:shadow-[0_25px_55px_rgba(45,50,32,0.13)]"
          >

            <!-- ==================================================
                 IMAGE
                 ================================================== -->

            <div class="relative aspect-[1.18/0.85] overflow-hidden">

              <!-- IMAGE PLACEHOLDER -->
              <img
                src={service.image}
                alt={service.title}
                loading="lazy"
                class="service-image h-full w-full object-cover transition-transform duration-[1.1s] ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:scale-[1.06]"
              />

              <!-- Dark image overlay -->
              <div
                class="pointer-events-none absolute inset-0 bg-gradient-to-b from-black/5 via-transparent to-black/20 opacity-70 transition-opacity duration-700 group-hover:opacity-50"
              ></div>


              <!-- =================================================
                   CIRCULAR ICON
                   ================================================= -->

              <div
                class="absolute bottom-[-31px] left-1/2 z-20 flex h-[62px] w-[62px] -translate-x-1/2 items-center justify-center rounded-full border border-[#d7dbb9]/50 bg-[#78864a] text-[#f7f8e9] shadow-[0_8px_20px_rgba(48,55,29,0.16)] transition-all duration-500 group-hover:scale-110 group-hover:bg-[#6e7c40]"
              >

                {service.icon === "dining" && (
                  <svg
                    viewBox="0 0 32 32"
                    class="h-7 w-7"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.25"
                    aria-hidden="true"
                  >
                    <path d="M8 5v22" />
                    <path d="M5 5v8c0 2 1.2 3 3 3s3-1 3-3V5" />
                    <path d="M21 5v22" />
                    <path d="M25 5v22" />
                    <path d="M21 12h4" />
                    <path d="M16 5v22" />
                  </svg>
                )}

                {service.icon === "gift" && (
                  <svg
                    viewBox="0 0 32 32"
                    class="h-7 w-7"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.25"
                    aria-hidden="true"
                  >
                    <rect
                      x="5"
                      y="12"
                      width="22"
                      height="16"
                      rx="1.5"
                    />
                    <path d="M4 12h24v5H4z" />
                    <path d="M16 12v16" />
                    <path d="M16 12H10.5a3.5 3.5 0 1 1 0-7c3 0 5.5 7 5.5 7Z" />
                    <path d="M16 12h5.5a3.5 3.5 0 1 0 0-7c-3 0-5.5 7-5.5 7Z" />
                  </svg>
                )}

                {service.icon === "people" && (
                  <svg
                    viewBox="0 0 32 32"
                    class="h-7 w-7"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.25"
                    aria-hidden="true"
                  >
                    <circle cx="16" cy="10" r="4" />
                    <path d="M9 27v-2a7 7 0 0 1 14 0v2" />
                    <circle cx="7" cy="13" r="3" />
                    <path d="M2.5 27v-2a5 5 0 0 1 5-5" />
                    <circle cx="25" cy="13" r="3" />
                    <path d="M29.5 27v-2a5 5 0 0 0-5-5" />
                  </svg>
                )}

                {service.icon === "briefcase" && (
                  <svg
                    viewBox="0 0 32 32"
                    class="h-7 w-7"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.25"
                    aria-hidden="true"
                  >
                    <rect
                      x="4"
                      y="9"
                      width="24"
                      height="18"
                      rx="2"
                    />
                    <path d="M11 9V6a2 2 0 0 1 2-2h6a2 2 0 0 1 2 2v3" />
                    <path d="M4 15h24" />
                    <path d="M14 15v3h4v-3" />
                  </svg>
                )}

              </div>

            </div>


            <!-- ==================================================
                 CARD CONTENT
                 ================================================== -->

            <div
              class="flex min-h-[260px] flex-col items-center px-6 pb-7 pt-12 text-center sm:min-h-[270px] lg:px-5 xl:px-7"
            >

              <!-- Title -->
              <h3
                class="font-serif text-[28px] leading-none tracking-[-0.035em] text-[#22251d]"
              >
                {service.title}
              </h3>


              <!-- Small divider -->
              <div
                class="mt-5 h-px w-8 bg-[#788450]/50 transition-all duration-500 group-hover:w-12"
              ></div>


              <!-- Description -->
              <p
                class="mt-4 max-w-[270px] text-[14px] leading-6 text-[#4f534b] sm:text-[13.5px] sm:leading-6 xl:text-sm"
              >
                {service.description}
              </p>


              <!-- Action -->
              <a
                href={service.href}
                class="group/link mt-auto inline-flex items-center gap-3 pt-6 text-sm font-medium text-[#6e7d43]"
              >
                <span class="transition-colors duration-300 group-hover/link:text-[#4e5c2d]">
                  {service.action}
                </span>

                <svg
                  viewBox="0 0 24 24"
                  class="h-5 w-5 transition-transform duration-500 group-hover/link:translate-x-1"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.25"
                  aria-hidden="true"
                >
                  <path d="M4 12h15" />
                  <path d="m13 6 6 6-6 6" />
                </svg>
              </a>

            </div>

          </article>
        ))
      }

    </div>


    <!-- ==========================================================
         BOTTOM CTA
         ========================================================== -->

    <div
      data-reveal
      data-delay="750"
      class="mt-8 border-t border-[#d7d8c8] pt-7 sm:mt-10 sm:pt-8"
    >

      <div
        class="flex flex-col gap-7 sm:flex-row sm:items-center sm:justify-center lg:gap-24"
      >

        <!-- Message -->
        <div class="flex items-center gap-4 sm:min-w-0">

          <!-- Leaf -->
          <div class="shrink-0 text-[#788450]">

            <svg
              viewBox="0 0 32 32"
              class="h-9 w-9"
              fill="none"
              stroke="currentColor"
              stroke-width="1.2"
              aria-hidden="true"
            >
              <path d="M16 29V10" />
              <path
                d="M16 17C10 17 6 13 6 7c6 0 10 4 10 10Z"
              />
              <path
                d="M16 23c6 0 10-4 10-10-6 0-10 4-10 10Z"
              />
            </svg>

          </div>


          <div>

            <p
              class="font-serif text-[17px] leading-tight tracking-[-0.015em] text-[#25281f]"
            >
              Looking for something special?
            </p>

            <p
              class="mt-1 text-sm leading-6 text-[#555950]"
            >
              Our team is here to help you plan the perfect experience.
            </p>

          </div>

        </div>


        <!-- CTA -->
        <a
          href="/contact"
          class="group inline-flex shrink-0 items-center justify-center gap-7 rounded-full bg-[#788548] px-8 py-3.5 text-sm font-medium text-white shadow-[0_10px_25px_rgba(76,88,43,0.13)] transition-all duration-500 hover:-translate-y-0.5 hover:bg-[#68763b] hover:shadow-[0_15px_35px_rgba(76,88,43,0.2)]"
        >
          <span>Contact Our Team</span>

          <svg
            viewBox="0 0 24 24"
            class="h-5 w-5 transition-transform duration-500 group-hover:translate-x-1"
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"
            aria-hidden="true"
          >
            <path d="M4 12h15" />
            <path d="m13 6 6 6-6 6" />
          </svg>
        </a>

      </div>

    </div>

  </div>
</section>


<!-- ================================================================
     SCROLL REVEAL
     ================================================================ -->

<script>
  const revealElements =
    document.querySelectorAll<HTMLElement>("[data-reveal]");

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if ("IntersectionObserver" in window && !reduceMotion) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          const element = entry.target as HTMLElement;
          const delay = element.dataset.delay ?? "0";

          element.style.setProperty(
            "--reveal-delay",
            `${delay}ms`,
          );

          element.classList.add("is-visible");

          observer.unobserve(element);
        });
      },
      {
        threshold: 0.12,
        rootMargin: "0px 0px -60px 0px",
      },
    );

    revealElements.forEach((element) => {
      observer.observe(element);
    });
  } else {
    revealElements.forEach((element) => {
      element.classList.add("is-visible");
    });
  }
</script>


<style>
  /* ============================================================
     REVEAL ANIMATION
     ============================================================ */

  [data-reveal] {
    opacity: 0;
    transform: translateY(32px);
    transition:
      opacity 900ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
    will-change: opacity, transform;
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }


  /* ============================================================
     CARD IMAGE
     ============================================================ */

  .service-image {
    transform: scale(1.001);
    backface-visibility: hidden;
  }


  /* ============================================================
     CARD
     ============================================================ */

  .service-card {
    transform: translateZ(0);
    backface-visibility: hidden;
  }


  /* ============================================================
     MOBILE
     ============================================================ */

  @media (max-width: 639px) {
    [data-reveal] {
      transform: translateY(24px);
    }

    .service-card {
      border-radius: 18px;
    }
  }


  /* ============================================================
     REDUCED MOTION
     ============================================================ */

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .service-image {
      transition: none;
    }

    .service-card {
      transition: none;
    }
  }
</style>