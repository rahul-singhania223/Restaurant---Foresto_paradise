<section
  class="relative overflow-hidden bg-[#eeeDE4] px-6 py-24 sm:px-10 sm:py-28 lg:px-16 lg:py-32 xl:px-20"
>
  <!-- Decorative circles -->
  <div
    class="pointer-events-none absolute -left-32 top-1/2 h-[420px] w-[420px] -translate-y-1/2 rounded-full border border-[#c9c9b8]/40"
    aria-hidden="true"
  ></div>

  <div
    class="pointer-events-none absolute -right-48 top-1/2 h-[520px] w-[520px] -translate-y-1/2 rounded-full border border-[#c9c9b8]/30"
    aria-hidden="true"
  ></div>

  <div class="relative mx-auto max-w-[850px] text-center">

    <!-- Eyebrow -->
    <div class="mb-6 flex items-center justify-center gap-3">
      <span class="h-px w-8 bg-[#9b9c77]"></span>

      <span
        class="text-[10px] font-medium uppercase tracking-[0.28em] text-[#74765e]"
      >
        Your Table Awaits
      </span>

      <span class="h-px w-8 bg-[#9b9c77]"></span>
    </div>

    <!-- Heading -->
    <h2
      class="font-serif text-[clamp(3rem,6vw,5.8rem)] font-normal leading-[0.9] tracking-[-0.05em] text-[#171a14]"
    >
      Found something
      <span class="block text-[#85875b]">
        you love?
      </span>
    </h2>

    <!-- Description -->
    <p
      class="mx-auto mt-7 max-w-[520px] text-[14px] leading-7 text-[#6f7169] sm:text-[15px]"
    >
      Make it part of your next visit. Reserve your table
      and enjoy the flavours of Foresto Paradise with the
      people who matter.
    </p>

    <!-- CTA -->
    <div class="mt-9 flex flex-col items-center justify-center gap-4 sm:flex-row">

      <button
        data-reservation-trigger
        class="group inline-flex h-[54px] items-center gap-4 rounded-full bg-[#1b2116] px-7 text-[13px] font-medium text-white transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#292f23] hover:shadow-[0_16px_35px_rgba(20,25,15,0.15)]"
      >
        <span>Reserve a Table</span>

        <span
          class="flex h-7 w-7 items-center justify-center rounded-full bg-white/10 transition-transform duration-300 group-hover:translate-x-0.5"
        >
          <svg
            viewBox="0 0 16 16"
            class="h-3.5 w-3.5"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            aria-hidden="true"
          >
            <path d="M2.5 8h10" />
            <path d="m8.5 4 4 4-4 4" />
          </svg>
        </span>
      </button>

      <a
        href="/contact"
        class="inline-flex h-[54px] items-center rounded-full border border-[#c9c9bd] px-7 text-[13px] font-medium text-[#34372f] transition-all duration-300 hover:border-[#92936f] hover:bg-white/50"
      >
        Contact Us
      </a>

    </div>

    <!-- Bottom detail -->
    <div class="mt-10 flex items-center justify-center gap-3">
      <span class="h-1 w-1 rounded-full bg-[#9b9c77]"></span>

      <span
        class="text-[9px] uppercase tracking-[0.22em] text-[#96978e]"
      >
        Dine · Relax · Enjoy
      </span>

      <span class="h-1 w-1 rounded-full bg-[#9b9c77]"></span>
    </div>

  </div>
</section>