---
import { Image } from "astro:assets";

const stats = [
  {
    value: "10+",
    label: "Years of Passion",
    icon: "leaf",
  },
  {
    value: "2L+",
    label: "Happy Guests",
    icon: "people",
  },
  {
    value: "50+",
    label: "Signature Dishes",
    icon: "cloche",
  },
];

const experiences = [
  {
    title: "Fresh Ingredients",
    description: "Sourced locally and prepared with care.",
    icon: "leaf",
  },
  {
    title: "Authentic Flavours",
    description: "Timeless recipes crafted with passion and tradition.",
    icon: "heart",
  },
  {
    title: "Warm Hospitality",
    description: "Because every guest feels like family.",
    icon: "people",
  },
];
---

<section
  id="about"
  class="about-section relative overflow-hidden bg-[#f2f2e3] text-[#20231b]"
>
  <!-- ============================================================
       BACKGROUND ATMOSPHERE
       ============================================================ -->

  <div
    class="pointer-events-none absolute inset-0 -z-10 bg-[radial-gradient(circle_at_20%_45%,rgba(255,255,255,0.75),transparent_38%),radial-gradient(circle_at_85%_50%,rgba(217,219,191,0.28),transparent_42%)]"
  ></div>


  <!-- ============================================================
       DECORATIVE BACKGROUND LEAF
       Replace image with your own asset.
       ============================================================ -->

  <div
    class="pointer-events-none absolute -left-20 bottom-[-80px] -z-10 hidden w-72 opacity-[0.10] sm:block lg:w-96"
  >
    <img
      src="/images/about/about-leaf.png"
      alt=""
      class="about-background-leaf w-full"
      loading="lazy"
    />
  </div>


  <!-- ============================================================
       CONTAINER
       ============================================================ -->

  <div
    class="mx-auto max-w-[1500px] px-5 py-20 sm:px-8 sm:py-24 lg:px-12 lg:py-28 xl:px-16"
  >

    <div
      class="grid items-center gap-14 lg:grid-cols-[0.86fr_1.14fr] lg:gap-16 xl:gap-20"
    >

      <!-- ========================================================
           LEFT CONTENT
           ======================================================== -->

      <div class="relative z-10 max-w-[600px]">

        <!-- Eyebrow -->
        <div
          data-reveal
          class="flex items-center gap-3 text-[11px] font-medium uppercase tracking-[0.19em] text-[#697441] sm:text-xs"
        >
          <svg
            viewBox="0 0 24 24"
            class="h-7 w-7 shrink-0"
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"
            aria-hidden="true"
          >
            <path d="M12 21V8" />
            <path
              d="M12 12C8.5 12 6 9.5 6 6c3.5 0 6 2.5 6 6Z"
            />
            <path
              d="M12 15c3.5 0 6-2.5 6-9-3.5 0-6 2.5-6 6Z"
            />
          </svg>

          <span>About Foresto Paradise</span>
        </div>


        <!-- Heading -->
        <h2
          data-reveal
          data-delay="100"
          class="mt-7 font-serif text-[clamp(3rem,5.5vw,5.3rem)] font-normal leading-[0.96] tracking-[-0.045em]"
        >
          More than a meal.
          <span class="mt-2 block">
            It’s an
            <span class="text-[#788450]">experience.</span>
          </span>
        </h2>


        <!-- Decorative divider -->
        <div
          data-reveal
          data-delay="160"
          class="mt-7 flex items-center gap-4"
        >
          <span class="h-px w-11 bg-[#7b8552]/60"></span>

          <svg
            viewBox="0 0 24 24"
            class="h-5 w-5 text-[#788450]"
            fill="none"
            stroke="currentColor"
            stroke-width="1.25"
            aria-hidden="true"
          >
            <path d="M12 21V8" />
            <path
              d="M12 12C8.5 12 6 9.5 6 6c3.5 0 6 2.5 6 6Z"
            />
            <path
              d="M12 15c3.5 0 6-2.5 6-9-3.5 0-6 2.5-6 6Z"
            />
          </svg>

          <span class="h-px w-11 bg-[#7b8552]/60"></span>
        </div>


        <!-- Description -->
        <p
          data-reveal
          data-delay="220"
          class="mt-8 max-w-[540px] text-[15px] leading-7 text-[#555950] sm:text-base sm:leading-8"
        >
          At Foresto Paradise, every detail is designed to make
          your time with us memorable. From the way we source
          our ingredients to the warmth of our spaces, everything
          we do is rooted in our love for good food and
          great company.
        </p>


        <!-- ======================================================
             STATS
             ====================================================== -->

        <div
          data-reveal
          data-delay="320"
          class="mt-10 grid max-w-[570px] grid-cols-3"
        >

          {
            stats.map((stat, index) => (
              <div
                class:list={[
                  "flex flex-col items-center text-center sm:items-start sm:text-left",
                  index !== 0 &&
                    "border-l border-[#d5d6c4] pl-4 sm:pl-7",
                ]}
              >

                <!-- Icon -->
                <div class="mb-5 text-[#788450]">

                  {stat.icon === "leaf" && (
                    <svg
                      viewBox="0 0 32 32"
                      class="h-9 w-9"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.25"
                      aria-hidden="true"
                    >
                      <path d="M16 29V11" />
                      <path
                        d="M16 17C10 17 6 13 6 7c6 0 10 4 10 10Z"
                      />
                      <path
                        d="M16 23c6 0 10-4 10-10-6 0-10 4-10 10Z"
                      />
                    </svg>
                  )}

                  {stat.icon === "people" && (
                    <svg
                      viewBox="0 0 32 32"
                      class="h-9 w-9"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.25"
                      aria-hidden="true"
                    >
                      <circle cx="16" cy="10" r="4" />
                      <path d="M9 26v-2a7 7 0 0 1 14 0v2" />
                      <circle cx="7" cy="13" r="3" />
                      <path d="M2.5 26v-2a5 5 0 0 1 5-5" />
                      <circle cx="25" cy="13" r="3" />
                      <path d="M29.5 26v-2a5 5 0 0 0-5-5" />
                    </svg>
                  )}

                  {stat.icon === "cloche" && (
                    <svg
                      viewBox="0 0 32 32"
                      class="h-9 w-9"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.25"
                      aria-hidden="true"
                    >
                      <path d="M5 22h22" />
                      <path
                        d="M8 22c0-7 3.5-11 8-11s8 4 8 11"
                      />
                      <path d="M12 7c0-2 1.5-3 4-3s4 1 4 3" />
                      <path d="M3 25h26" />
                    </svg>
                  )}

                </div>


                <p
                  class="font-serif text-[34px] leading-none tracking-[-0.035em] text-[#1e211a] sm:text-[38px]"
                >
                  {stat.value}
                </p>

                <p
                  class="mt-3 text-xs font-medium text-[#373b31] sm:text-sm"
                >
                  {stat.label}
                </p>

              </div>
            ))
          }

        </div>


        <!-- ======================================================
             STORY BUTTON
             ====================================================== -->

        <div
          data-reveal
          data-delay="420"
          class="mt-10"
        >
          <a
            href="/about"
            class="group inline-flex items-center gap-5 rounded-full bg-[#788548] px-7 py-3.5 text-sm font-medium text-white shadow-[0_12px_30px_rgba(83,95,49,0.16)] transition-all duration-500 hover:-translate-y-0.5 hover:bg-[#69783d] hover:shadow-[0_16px_35px_rgba(83,95,49,0.22)]"
          >
            <span>Our Story</span>

            <svg
              viewBox="0 0 24 24"
              class="h-5 w-5 transition-transform duration-500 group-hover:translate-x-1"
              fill="none"
              stroke="currentColor"
              stroke-width="1.3"
              aria-hidden="true"
            >
              <path d="M5 12h13" />
              <path d="m13 7 5 5-5 5" />
            </svg>
          </a>
        </div>

      </div>


      <!-- ========================================================
           RIGHT IMAGE / EXPERIENCE
           ======================================================== -->

      <div
        class="relative min-w-0 lg:pt-3"
      >

        <!-- ======================================================
             MAIN IMAGE
             ====================================================== -->

        <div
          data-reveal
          data-delay="200"
          class="about-image relative ml-auto aspect-[1.15/1] w-full max-w-[760px] overflow-hidden rounded-[24px] bg-[#dfe0cd] shadow-[0_25px_70px_rgba(41,47,27,0.12)] sm:rounded-[28px] lg:aspect-[1.1/1]"
        >

          <!-- IMAGE PLACEHOLDER -->
          <Image
            src="/images/about.png"
            alt="Foresto Paradise restaurant interior"
            class="h-full w-full object-cover transition-transform duration-[1.2s] ease-out hover:scale-[1.025]"
            loading="lazy"
            width={760}
            height={760}
          />

          <!-- Image color treatment -->
          <div
            class="pointer-events-none absolute inset-0 bg-gradient-to-tr from-[#10150d]/15 via-transparent to-[#fff]/5"
          ></div>

        </div>


        <!-- ======================================================
             FLOATING EXPERIENCE CARD
             ====================================================== -->

        <div
          data-reveal
          data-delay="500"
          class="about-experience-card relative z-20 mt-[-25px] ml-[-5px] w-[calc(100%+10px)] rounded-[25px] border border-white/70 bg-[#f7f7eb]/90 p-5 shadow-[0_20px_55px_rgba(39,45,27,0.12)] backdrop-blur-xl sm:mt-[-60px] sm:ml-[-35px] sm:w-[calc(100%+70px)] sm:rounded-[28px] sm:p-7 lg:mt-[-75px] lg:ml-[-45px] lg:w-[calc(100%+45px)] lg:p-8 xl:ml-[-70px] xl:w-[calc(100%+70px)]"
        >

          <div
            class="grid grid-cols-1 divide-y divide-[#d8d9c9] sm:grid-cols-3 sm:divide-x sm:divide-y-0"
          >

            {
              experiences.map((experience) => (
                <div
                  class="flex items-center gap-4 py-5 first:pt-1 last:pb-1 sm:block sm:px-6 sm:py-1 first:sm:pl-2 last:sm:pr-2 lg:px-7"
                >

                  <!-- Circular icon -->
                  <div
                    class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full bg-[#e9eadc] text-[#6e7d46] sm:mx-auto sm:h-14 sm:w-14"
                  >

                    {experience.icon === "leaf" && (
                      <svg
                        viewBox="0 0 24 24"
                        class="h-6 w-6"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.25"
                        aria-hidden="true"
                      >
                        <path d="M12 21V8" />
                        <path
                          d="M12 12C8.5 12 6 9.5 6 6c3.5 0 6 2.5 6 6Z"
                        />
                        <path
                          d="M12 15c3.5 0 6-2.5 6-9-3.5 0-6 2.5-6 6Z"
                        />
                      </svg>
                    )}

                    {experience.icon === "heart" && (
                      <svg
                        viewBox="0 0 24 24"
                        class="h-6 w-6"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.25"
                        aria-hidden="true"
                      >
                        <path
                          d="M20.8 8.8c0 5.5-8.8 10.2-8.8 10.2S3.2 14.3 3.2 8.8A4.6 4.6 0 0 1 12 6.3a4.6 4.6 0 0 1 8.8 2.5Z"
                        />
                      </svg>
                    )}

                    {experience.icon === "people" && (
                      <svg
                        viewBox="0 0 24 24"
                        class="h-6 w-6"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.25"
                        aria-hidden="true"
                      >
                        <circle cx="12" cy="8" r="3" />
                        <path d="M6 20v-1a6 6 0 0 1 12 0v1" />
                        <circle cx="5" cy="10" r="2" />
                        <circle cx="19" cy="10" r="2" />
                      </svg>
                    )}

                  </div>


                  <!-- Text -->
                  <div class="sm:mt-4 sm:text-center">

                    <h3
                      class="font-serif text-[18px] leading-tight tracking-[-0.02em] text-[#292c23] sm:text-[19px]"
                    >
                      {experience.title}
                    </h3>

                    <p
                      class="mt-2 max-w-[220px] text-sm leading-6 text-[#5c6057] sm:mx-auto"
                    >
                      {experience.description}
                    </p>

                  </div>

                </div>
              ))
            }

          </div>
        </div>


        <!-- ======================================================
             DECORATIVE CORNER
             ====================================================== -->

        <div
          class="pointer-events-none absolute -bottom-8 -right-5 hidden text-[#788450]/20 lg:block"
        >
          <svg
            viewBox="0 0 120 120"
            class="h-28 w-28"
            fill="none"
            stroke="currentColor"
            stroke-width="1"
          >
            <path d="M10 110C35 80 55 55 110 10" />
            <path d="M32 86C22 72 22 57 30 45c12 8 15 23 2 41Z" />
            <path d="M56 62C47 48 49 34 58 23c10 9 10 24-2 39Z" />
            <path d="M77 42C72 29 77 18 88 10c6 11 2 24-11 32Z" />
          </svg>
        </div>

      </div>

    </div>

  </div>
</section>


<!-- ================================================================
     SCROLL REVEAL
     ================================================================ -->

<script>
  const revealElements =
    document.querySelectorAll<HTMLElement>("[data-reveal]");

  const reduceMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  ).matches;

  if ("IntersectionObserver" in window && !reduceMotion) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          const element = entry.target as HTMLElement;
          const delay = element.dataset.delay ?? "0";

          element.style.setProperty(
            "--reveal-delay",
            `${delay}ms`,
          );

          element.classList.add("is-visible");

          observer.unobserve(element);
        });
      },
      {
        threshold: 0.12,
        rootMargin: "0px 0px -70px 0px",
      },
    );

    revealElements.forEach((element) => {
      observer.observe(element);
    });
  } else {
    revealElements.forEach((element) => {
      element.classList.add("is-visible");
    });
  }
</script>


<style>
  /* ============================================================
     SCROLL REVEAL
     ============================================================ */

  [data-reveal] {
    opacity: 0;
    transform: translateY(30px);
    transition:
      opacity 900ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
    will-change: opacity, transform;
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }


  /* ============================================================
     BACKGROUND LEAF
     ============================================================ */

  .about-background-leaf {
    animation: about-leaf-float 10s ease-in-out infinite;
    transform-origin: center;
  }

  @keyframes about-leaf-float {
    0%,
    100% {
      transform: translate3d(0, 0, 0) rotate(0deg);
    }

    50% {
      transform: translate3d(8px, -8px, 0) rotate(2deg);
    }
  }


  /* ============================================================
     IMAGE
     ============================================================ */

  .about-image {
    transform: translateZ(0);
    backface-visibility: hidden;
  }


  /* ============================================================
     FLOATING EXPERIENCE CARD
     ============================================================ */

  .about-experience-card {
    animation: experience-card-float 8s ease-in-out infinite;
  }

  @keyframes experience-card-float {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(-4px);
    }
  }


  /* ============================================================
     MOBILE
     ============================================================ */

  @media (max-width: 639px) {
    [data-reveal] {
      transform: translateY(22px);
    }

    .about-experience-card {
      animation-duration: 9s;
    }
  }


  /* ============================================================
     REDUCED MOTION
     ============================================================ */

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .about-background-leaf,
    .about-experience-card {
      animation: none;
    }

    .about-image img {
      transition: none;
    }
  }
</style>