---
import { Image } from "astro:assets";

const signatureDishes = [
  {
    name: "Signature Biryani",
    category: "Chef's Special",
    description:
      "Fragrant basmati rice layered with aromatic spices and tender, slow-cooked meat.",
    price: "₹___",
    image: "https://images.unsplash.com/photo-1563379091339-03b21ab4a4f8?q=80&w=810&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
  },
  {
    name: "Paneer Tikka",
    category: "From the Tandoor",
    description:
      "Tender cottage cheese marinated in aromatic spices and grilled to perfection.",
    price: "₹___",
    image: "https://images.unsplash.com/photo-1631452180519-c014fe946bc7?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8M3x8cGFuZWVyJTIwdGlra2F8ZW58MHx8MHx8fDA%3D",
  },
  {
    name: "Tandoori Chicken",
    category: "From the Tandoor",
    description:
      "Juicy chicken marinated with traditional spices and roasted over high heat.",
    price: "₹___",
    image: "https://plus.unsplash.com/premium_photo-1661419883163-bb4df1c10109?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MXx8dGFuZG9vcmklMjBjaGlja2VufGVufDB8fDB8fHww",
  },
];
---

<section
  id="signatures"
  class="signature-section bg-[#f8f7f2] px-6 py-24 sm:px-10 sm:py-28 lg:px-16 lg:py-32 xl:px-20"
>
  <div class="mx-auto max-w-[1720px]">

    <!-- ============================================================
         SECTION INTRO
         ============================================================ -->

    <div
      class="flex flex-col gap-8 lg:flex-row lg:items-end lg:justify-between"
    >
      <!-- Text -->

      <div class="max-w-[650px]">

        <!-- Eyebrow -->

        <div
          data-reveal
          data-delay="0"
          class="mb-5 flex items-center gap-3"
        >
          <span class="h-px w-9 bg-[#b8b878]"></span>

          <span
            class="text-[11px] font-medium uppercase tracking-[0.24em] text-[#74765e]"
          >
            Chef's Selection
          </span>
        </div>

        <!-- Heading -->

        <h2
          data-reveal
          data-delay="100"
          class="font-serif text-[clamp(3rem,5vw,5.4rem)] font-normal leading-[0.92] tracking-[-0.045em] text-[#171a14]"
        >
          A few of our

          <span class="block text-[#8c8e60]">
            favourites.
          </span>
        </h2>

        <!-- Description -->

        <p
          data-reveal
          data-delay="220"
          class="mt-6 max-w-[530px] text-[15px] leading-7 text-[#686a62] sm:text-base"
        >
          A selection of dishes our chefs love to serve.
          Made with fresh ingredients, thoughtful preparation,
          and the flavours that define Foresto Paradise.
        </p>
      </div>

      <!-- View full menu -->

      <a
        href="#starters"
        data-reveal
        data-delay="320"
        class="group inline-flex w-fit shrink-0 items-center gap-4 border-b border-[#b8b878]/50 pb-2 text-[13px] font-medium text-[#303329] transition-colors duration-300 hover:border-[#74764f] hover:text-[#74764f]"
      >
        <span>Explore Full Menu</span>

        <svg
          viewBox="0 0 20 20"
          class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
          fill="none"
          stroke="currentColor"
          stroke-width="1.4"
          aria-hidden="true"
        >
          <path d="M3 10h13" />
          <path d="m11 5 5 5-5 5" />
        </svg>
      </a>
    </div>

    <!-- ============================================================
         SIGNATURE DISHES
         ============================================================ -->

    <div
      class="mt-14 grid gap-5 sm:mt-16 md:grid-cols-2 lg:grid-cols-3 lg:gap-6"
    >
      {
        signatureDishes.map((dish, index) => (
          <article
            data-reveal
            data-delay={`${400 + index * 120}`}
            class:list={[
              "group relative overflow-hidden rounded-[28px] bg-[#e9e8df]",
              index === 0
                ? "md:col-span-2 lg:col-span-1"
                : "",
            ]}
          >
            <!-- Image -->

            <div class="relative aspect-[4/5] overflow-hidden">
              <Image
                src={dish.image}
                alt={dish.name}
                width={900}
                height={1125}
                class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.04]"
                format="webp"
              />

              <!-- Image gradient -->

              <div
                class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-transparent"
              ></div>

              <!-- Category -->

              <div class="absolute left-5 top-5">
                <span
                  class="inline-flex rounded-full border border-white/20 bg-black/20 px-3.5 py-2 text-[10px] font-medium uppercase tracking-[0.16em] text-white/90 backdrop-blur-md"
                >
                  {dish.category}
                </span>
              </div>

              <!-- Bottom content -->

              <div class="absolute inset-x-0 bottom-0 p-6 sm:p-7">
                <div class="flex items-end justify-between gap-4">

                  <div>
                    <h3
                      class="font-serif text-[29px] leading-none tracking-[-0.025em] text-white sm:text-[32px]"
                    >
                      {dish.name}
                    </h3>

                    <p
                      class="mt-3 max-w-[340px] text-[12px] leading-5 text-white/65 sm:text-[13px]"
                    >
                      {dish.description}
                    </p>
                  </div>

                  <!-- Price -->

                  <span
                    class="shrink-0 text-sm font-medium text-[#d6d18c]"
                  >
                    {dish.price}
                  </span>

                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <!-- ============================================================
         SMALL BOTTOM NOTE
         ============================================================ -->

    <div
      data-reveal
      data-delay="780"
      class="mt-8 flex items-center justify-center gap-3 text-center"
    >
      <span class="h-px w-8 bg-[#d5d4ca]"></span>

      <p
        class="text-[10px] uppercase tracking-[0.2em] text-[#92938a]"
      >
        Prepared fresh at Foresto Paradise
      </p>

      <span class="h-px w-8 bg-[#d5d4ca]"></span>
    </div>

  </div>
</section>

<!-- ================================================================
     SCROLL REVEAL
     ================================================================ -->

<style>
  [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    will-change: opacity, transform;
  }

  [data-reveal].is-visible {
    animation: signatureReveal
      0.85s
      cubic-bezier(0.22, 1, 0.36, 1)
      forwards;
    animation-delay: var(--reveal-delay, 0ms);
  }

  @keyframes signatureReveal {
    from {
      opacity: 0;
      transform: translateY(28px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
    }

    [data-reveal].is-visible {
      animation: none;
    }
  }
</style>

<!-- ================================================================
     INTERSECTION OBSERVER
     ================================================================ -->

<script>
  const revealElements =
    document.querySelectorAll<HTMLElement>("[data-reveal]");

  if (
    "IntersectionObserver" in window &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          const element = entry.target as HTMLElement;

          const delay = element.dataset.delay ?? "0";

          element.style.setProperty(
            "--reveal-delay",
            `${delay}ms`
          );

          element.classList.add("is-visible");

          // Animate only once.
          observer.unobserve(element);
        });
      },
      {
        threshold: 0.12,
        rootMargin: "0px 0px -60px 0px",
      }
    );

    revealElements.forEach((element) => {
      observer.observe(element);
    });
  } else {
    revealElements.forEach((element) => {
      element.classList.add("is-visible");
    });
  }
</script>