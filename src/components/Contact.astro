<style>
  /* =============================================================
     REVEAL ANIMATION
     ============================================================= */

  [data-reveal],
  [data-reveal-item],
  [data-reveal-chef] {
    will-change: transform, opacity;
  }

  [data-reveal-item] {
    transform: translateY(28px);
    transition:
      opacity 0.9s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.9s cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-reveal-item].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  [data-reveal-chef] {
    transform: translate3d(45px, 20px, 0) scale(0.97);
    transition:
      opacity 1.2s cubic-bezier(0.22, 1, 0.36, 1),
      transform 1.4s cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-reveal-chef].is-visible {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }

  /* =============================================================
     IMAGE DEPTH
     ============================================================= */

  section img {
    transition: transform 1.8s cubic-bezier(0.22, 1, 0.36, 1);
  }

  section [data-reveal].is-visible img {
    transform: scale(1.015);
  }

  /* =============================================================
     ACCESSIBILITY
     ============================================================= */

  @media (prefers-reduced-motion: reduce) {
    [data-reveal-item],
    [data-reveal-chef],
    section img {
      transition: none !important;
      transform: none !important;
    }
  }

  /* =============================================================
     MOBILE
     ============================================================= */

  @media (max-width: 1023px) {
    [data-reveal] {
      min-height: auto;
    }
  }

  @media (max-width: 640px) {
    section {
      padding-top: 3.5rem;
      padding-bottom: 3.5rem;
    }

    [data-reveal-item] {
      transform: translateY(20px);
    }

    [data-reveal-chef] {
      transform: translateY(20px);
    }
  }
</style>

<script>
  const revealElements = document.querySelectorAll(
    "[data-reveal-item], [data-reveal-chef]"
  );

  if ("IntersectionObserver" in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      },
      {
        threshold: 0.12,
        rootMargin: "0px 0px -60px 0px",
      }
    );

    revealElements.forEach((element, index) => {
      // Small stagger between content elements
      if (element.hasAttribute("data-reveal-item")) {
        // @ts-ignore
        element.style.transitionDelay = `${index * 90}ms`;
      }

      observer.observe(element);
    });
  } else {
    revealElements.forEach((element) => {
      element.classList.add("is-visible");
    });
  }
</script>