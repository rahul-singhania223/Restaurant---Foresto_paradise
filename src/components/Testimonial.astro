<!-- =============================================================
     TESTIMONIAL CAROUSEL LOGIC
     ============================================================= -->
<script>
  const testimonials = [
    {
      text: `From the moment we walked in, everything was perfect. The food, the ambience, the service — truly a memorable experience. Foresto Paradise is our go-to place for every special occasion.`,
      name: "Ananya Sharma",
      location: "Patna",
      avatar: "/images/testimonials/ananya-sharma.jpg",
    },
    {
      text: `The food was exceptional and the atmosphere was even better. Every little detail felt thoughtful, warm and welcoming. We had an amazing evening and will definitely be coming back.`,
      name: "Rohan Mehta",
      location: "Patna",
      avatar: "https://images.unsplash.com/photo-1564564321837-a57b7070ac4f?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Nnx8bWFufGVufDB8fDB8fHww",
    },
    {
      text: `One of the best dining experiences we've had in Patna. The flavours were incredible, the staff was attentive and the ambience made the entire evening feel special.`,
      name: "Priya Verma",
      location: "Patna",
      avatar: "https://images.unsplash.com/photo-1592621385612-4d7129426394?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8Mnx8d29tYW58ZW58MHx8MHx8fDA%3D",
    },
    {
      text: `Foresto Paradise has become our favourite place for celebrations. Great food, beautiful surroundings and genuinely warm hospitality. It feels less like a restaurant and more like a place you want to return to.`,
      name: "Arjun Kapoor",
      location: "Lucknow",
      avatar: "https://images.unsplash.com/photo-1557862921-37829c790f19?w=600&auto=format&fit=crop&q=60&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8OHx8bWFufGVufDB8fDB8fHww",
    },
  ];

  const card = document.querySelector("[data-testimonial-card]");
  const text = document.querySelector("[data-testimonial-text]");
  const name = document.querySelector("[data-testimonial-name]");
  const location = document.querySelector("[data-testimonial-location]");
  const avatar = document.querySelector("[data-testimonial-avatar]");


  const prevButtons = document.querySelectorAll(
    "[data-testimonial-prev], [data-testimonial-prev-mobile]"
  );

  const nextButtons = document.querySelectorAll(
    "[data-testimonial-next], [data-testimonial-next-mobile]"
  );

  const dots = document.querySelectorAll("[data-testimonial-dot]");

  let currentIndex = 0;
  let isAnimating = false;

  function updateDots() {
    dots.forEach((dot, index) => {
      if (index === currentIndex) {
        dot.classList.remove("bg-[#c8c9bf]", "w-2.5");
        dot.classList.add("bg-[#697344]", "w-7");
      } else {
        dot.classList.remove("bg-[#697344]", "w-7");
        dot.classList.add("bg-[#c8c9bf]", "w-2.5");
      }
    });
  }

  function changeTestimonial(newIndex: number, direction = 1) {
    if (isAnimating) return;

    isAnimating = true;

    const nextIndex =
      (newIndex + testimonials.length) % testimonials.length;

    if(!card || !text || !name || !location || !avatar) return


    // Exit animation
    card.style.opacity = "0";
    card.style.transform = `translateX(${direction * 20}px)`;

    setTimeout(() => {
      const testimonial = testimonials[nextIndex];

      text.textContent = testimonial.text;
      name.textContent = testimonial.name;
      location.textContent = testimonial.location;

      // Replace avatar
      avatar.innerHTML = `
        <img
          src="${testimonial.avatar}"
          alt="${testimonial.name}"
          class="h-full w-full object-cover"
          onerror="this.style.display='none'"
        />
      `;

      currentIndex = nextIndex;

      updateDots();

      // Start from opposite side
      card.style.transition = "none";
      card.style.transform = `translateX(${direction * -20}px)`;

      // Force browser reflow
      card.offsetHeight;

      // Enter animation
      card.style.transition =
        "opacity 500ms ease, transform 500ms cubic-bezier(0.22, 1, 0.36, 1)";

      card.style.opacity = "1";
      card.style.transform = "translateX(0)";

      setTimeout(() => {
        isAnimating = false;
      }, 500);
    }, 250);
  }

  prevButtons.forEach((button) => {
    button.addEventListener("click", () => {
      changeTestimonial(currentIndex - 1, -1);
    });
  });

  nextButtons.forEach((button) => {
    button.addEventListener("click", () => {
      changeTestimonial(currentIndex + 1, 1);
    });
  });

  dots.forEach((dot) => {
    dot.addEventListener("click", () => {
      // @ts-ignore
      const index = Number(dot.dataset.testimonialDot);

      if (index === currentIndex) return;

      const direction = index > currentIndex ? 1 : -1;

      changeTestimonial(index, direction);
    });
  });

  updateDots();
</script>