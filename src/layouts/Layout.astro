---
import '../styles/global.css';
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <link rel="icon" href="/favicon.ico" />
        <meta name="generator" content={Astro.generator} />
        <title>Restaurant Website</title>

        <!-- Google Fonts: Playfair Display (Headings) & Lato (Body) -->
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Lato:wght@400;700&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
    </head>
    
    <body class="bg-brand-cream text-brand-olive font-body antialiased scroll-smooth">
        <slot />
    </body>
</html>

<script>
  window.addEventListener('DOMContentLoaded', () => {
    // 1. Capture the 'ref' value from the URL query parameters
    const urlParams = new URLSearchParams(window.location.search);
    const ref = urlParams.get('ref');

    console.log('ref:', ref);

    // 2. Execute only if 'ref' exists
    if (ref) {
      // REPLACE WITH YOUR WEB APP URL FROM STEP 2
      const scriptUrl = 'https://script.google.com/macros/s/AKfycbxYUTzpeqvl0iDZfOvjmstg6Q_DLZsyPb7ciWhIH36S9blnARQQJaxlrg8zXnKvUatj/exec';

      fetch(scriptUrl, {
        method: 'POST',
        mode: 'no-cors', // Prevents CORS errors on Web Apps
        headers: {
          'Content-Type': 'text/plain;charset=utf-8'
        },
        body: JSON.stringify({ ref: ref })
      })
      .then(() => console.log('Successfully recorded referral for:', ref))
      .catch(err => console.error('Tracking error:', err));
    }
  });
</script>