---
import { Image } from "astro:assets";
---

<section
  class="bg-[#f8f7f2] px-6 py-16 sm:px-10 sm:py-20 lg:px-16 lg:py-24 xl:px-20"
>
  <div class="mx-auto max-w-[1320px]">
    <div
      class="relative isolate overflow-hidden rounded-[32px] bg-[#1a2015] px-7 py-12 sm:px-10 sm:py-14 lg:px-16 lg:py-16"
    >
      <!-- Decorative background -->
      <div
        class="pointer-events-none absolute -right-20 -top-32 -z-10 h-[400px] w-[400px] rounded-full bg-[#b8b878]/10 blur-3xl"
        aria-hidden="true"
      ></div>

      <div
        class="pointer-events-none absolute -bottom-40 -left-20 -z-10 h-[300px] w-[300px] rounded-full bg-[#7b8055]/10 blur-3xl"
        aria-hidden="true"
      ></div>

      <div
        class="flex flex-col gap-10 lg:flex-row lg:items-center lg:justify-between"
      >
        <!-- Content -->
        <div class="max-w-[650px]">

          <!-- Eyebrow -->
          <div class="mb-5 flex items-center gap-3">
            <span class="h-px w-8 bg-[#c9c486]"></span>

            <span
              class="text-[10px] font-medium uppercase tracking-[0.25em] text-[#c9c486]"
            >
              Take It With You
            </span>
          </div>

          <!-- Heading -->
          <h2
            class="font-serif text-[clamp(2.8rem,5vw,4.8rem)] font-normal leading-[0.92] tracking-[-0.045em] text-white"
          >
            Keep a taste of
            <span class="block text-[#c9c486]">
              Foresto Paradise.
            </span>
          </h2>

          <p
            class="mt-6 max-w-[520px] text-[14px] leading-7 text-white/60 sm:text-[15px]"
          >
            Planning your next visit? Download our complete menu
            and explore all our dishes, favourites and signature
            creations at your convenience.
          </p>
        </div>

        <!-- CTA -->
        <div class="shrink-0">
          <a
            href="/menu.pdf"
            download
            class="group inline-flex h-[58px] items-center gap-5 rounded-full bg-[#b8b878] px-7 text-[13px] font-medium text-[#171a12] transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#d0cf8c] hover:shadow-[0_15px_40px_rgba(185,185,120,0.18)]"
          >
            <span>Download Menu</span>

            <span
              class="flex h-8 w-8 items-center justify-center rounded-full bg-black/10 transition-transform duration-300 group-hover:translate-y-0.5"
            >
              <svg
                viewBox="0 0 20 20"
                class="h-4 w-4"
                fill="none"
                stroke="currentColor"
                stroke-width="1.5"
                aria-hidden="true"
              >
                <path d="M10 3v10" />
                <path d="m6 10 4 4 4-4" />
                <path d="M4 17h12" />
              </svg>
            </span>
          </a>

          <p class="mt-3 text-center text-[10px] text-white/35 lg:text-right">
            PDF · Updated menu
          </p>
        </div>
      </div>
    </div>
  </div>
</section>