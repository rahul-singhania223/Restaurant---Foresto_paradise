---



<Layout title="Menu | Foresto Paradise">
    <Navbar />
    <Hero />
    <MenuCategoryNav />
    <ChefSignature />
   <MenuSection
        id="starters"
        eyebrow="Begin Your Meal"
        title="Starters"
        description="Small plates made to awaken the appetite, from smoky tandoor favourites to crisp and flavourful bites."
        items={starters}
    />
    <MenuSection
        id="soups-salads"
        eyebrow="Fresh & Light"
        title="Soups & Salads"
        description="Fresh, comforting and thoughtfully prepared. A lighter beginning or a refreshing choice on its own."
        items={soupsAndSalads}
    />
    <MenuSection
        id="tandoor"
        eyebrow="From The Fire"
        title="Tandoor"
        description="Smoky, charred and full of character. Our tandoor brings out the depth of flavour in every bite."
        items={tandoorItems}
    />
    <MenuVisualBreak />
    <MenuSection
        id="main-course"
        eyebrow="From The Kitchen"
        title="Main Course"
        description="Hearty classics and house favourites prepared with layers of flavour, perfect for settling in and enjoying a proper meal."
        items={mainCourseItems}
    />
    <MenuSection
        id="rice-breads"
        eyebrow="From The Tandoor"
        title="Rice & Breads"
        description="Fragrant rice, slow-cooked biryanis and freshly baked breads made to complement every dish on the table."
        items={riceAndBreads}
    />
    <DownloadMenu />
    <ReservationCTA />
    <Footer />

    <ReservationModal />


  <!-- Menu content will go here -->
</Layout>