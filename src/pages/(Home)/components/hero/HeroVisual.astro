---
interface Props {
  image: string;
}

const { image } = Astro.props;
---

<div
  class="relative hidden h-[680px] lg:block xl:h-[760px]"
>

  <!-- ============================================================
       MAIN IMAGE
       ============================================================ -->

  <div
    class="absolute inset-x-[-8%] top-1/2 h-[90%] -translate-y-1/2 overflow-hidden rounded-[36px]"
  >

    <img
      src={image}
      alt="Foresto Paradise dining experience"
      class="h-full w-full object-cover object-center"
    />

    <!-- Image readability overlay -->
    <div
      class="absolute inset-0 bg-gradient-to-r from-[#0b0d09]/30 via-transparent to-transparent"
    ></div>

    <div
      class="absolute inset-0 bg-gradient-to-t from-[#0b0d09]/30 via-transparent to-transparent"
    ></div>

  </div>


  <!-- ============================================================
       FRESHLY PREPARED CARD
       ============================================================ -->

  <div
    class="absolute left-[8%] top-[21%] z-20 flex h-[140px] w-[140px] -translate-x-1/2 items-center justify-center rounded-full border border-[#c9c486]/40 bg-[#1d251b]/55 text-center shadow-[0_20px_60px_rgba(0,0,0,0.25)] backdrop-blur-md"
  >

    <div class="flex flex-col items-center gap-3">

      <svg
        viewBox="0 0 24 24"
        class="h-7 w-7 text-[#ddd58e]"
        fill="none"
        stroke="currentColor"
        stroke-width="1.35"
        aria-hidden="true"
      >
        <path d="M12 21V8" />
        <path d="M12 12C8.5 12 6 9.5 6 6c3.5 0 6 2.5 6 6Z" />
        <path d="M12 15c3.5 0 6-2.5 6-6-3.5 0-6 2.5-6 6Z" />
        <path d="M12 8c0-2.7 1.6-5 4-6 0 3-1.6 5.2-4 6Z" />
      </svg>

      <span
        class="max-w-[90px] text-sm font-medium leading-5 text-white/90"
      >
        Freshly<br />Prepared
      </span>

    </div>

  </div>


  <!-- ============================================================
       NATURAL INGREDIENTS CARD
       ============================================================ -->

  <div
    class="absolute bottom-[11%] right-[-1%] z-20 w-[280px] rounded-[30px] border border-[#c9c486]/30 bg-[#252919]/70 px-7 py-6 shadow-[0_25px_70px_rgba(0,0,0,0.3)] backdrop-blur-md"
  >

    <div class="flex items-start justify-between">

      <div class="flex gap-3">

        <svg
          viewBox="0 0 24 24"
          class="mt-0.5 h-5 w-5 shrink-0 text-[#c8c276]"
          fill="none"
          stroke="currentColor"
          stroke-width="1.3"
          aria-hidden="true"
        >
          <path d="M12 21V8" />
          <path d="M12 12C8.5 12 6 9.5 6 6c3.5 0 6 2.5 6 6Z" />
          <path d="M12 15c3.5 0 6-2.5 6-6-3.5 0-6 2.5-6 6Z" />
        </svg>

        <div>
          <p class="text-xs text-[#d2cd92]">
            Natural Ingredients
          </p>

          <p class="mt-1 text-sm font-medium text-white">
            Better Taste
          </p>
        </div>

      </div>


      <svg
        viewBox="0 0 24 24"
        class="mt-5 h-5 w-5 text-[#d2cd92]"
        fill="none"
        stroke="currentColor"
        stroke-width="1.2"
        aria-hidden="true"
      >
        <path d="M5 12h13" />
        <path d="m13 7 5 5-5 5" />
      </svg>

    </div>

    <div class="mt-5 h-px bg-[#c9c486]/25"></div>

  </div>

</div>