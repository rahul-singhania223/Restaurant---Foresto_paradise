---
---

<div class="relative z-20 max-w-[680px] lg:-mt-8">

  <!-- Eyebrow -->
  <div
    class="mb-7 inline-flex items-center gap-2 rounded-full border border-[#b7b16a]/20 bg-[#11150e]/70 px-4 py-2 text-[11px] font-medium tracking-[0.08em] text-[#c9c486] backdrop-blur-md sm:text-xs"
  >
    <svg
      viewBox="0 0 24 24"
      class="h-3.5 w-3.5"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path d="M12 21V8" />
      <path d="M12 12C8.5 12 6 9.5 6 6c3.5 0 6 2.5 6 6Z" />
      <path d="M12 15c3.5 0 6-2.5 6-6-3.5 0-6 2.5-6 6Z" />
      <path d="M12 8c0-2.7 1.6-5 4-6 0 3-1.6 5.2-4 6Z" />
    </svg>

    <span>A Restaurant Like No Other</span>
  </div>


  <!-- Main heading -->
  <h1
    class="max-w-[760px] font-serif text-[clamp(3.5rem,6.5vw,6.7rem)] font-normal leading-[0.91] tracking-[-0.045em]"
  >
    <span class="block text-[#f5f4ee]">
      Good Food.
    </span>

    <span
      class="mt-1 block bg-gradient-to-r from-[#d7cf88] via-[#b8b675] to-[#858d5b] bg-clip-text text-transparent"
    >
      Great Moments.
    </span>
  </h1>


  <!-- Description -->
  <p
    class="mt-7 max-w-[510px] text-[15px] leading-7 text-white/70 sm:text-base sm:leading-7"
  >
    Thoughtfully prepared food, warm spaces,
    <br class="hidden sm:block" />
    and moments worth staying for.
  </p>


  <!-- CTA -->
  <div class="mt-9 flex flex-wrap items-center gap-4">

    <!-- Primary -->
    <a
      href="/menu"
      class="group inline-flex h-[60px] items-center gap-5 rounded-full bg-[#b7b777] px-7 text-sm font-medium text-[#11140c] transition-all duration-300 hover:bg-[#d0cf8c] hover:shadow-[0_10px_40px_rgba(183,183,119,0.18)]"
    >
      <span>Explore Menu</span>

      <svg
        viewBox="0 0 20 20"
        class="h-4 w-4 transition-transform duration-300 group-hover:translate-x-1"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <path d="M4 16 16 4" />
        <path d="M8 4h8v8" />
      </svg>
    </a>


    <!-- Secondary -->
    <a
      href="/reservation"
      class="group inline-flex h-[60px] items-center gap-4 rounded-full border border-white/25 bg-black/10 px-7 text-sm font-medium text-white backdrop-blur-sm transition-all duration-300 hover:border-white/50 hover:bg-white/10"
    >
      <span>Book a Table</span>

      <svg
        viewBox="0 0 24 24"
        class="h-[18px] w-[18px] transition-transform duration-300 group-hover:scale-110"
        fill="none"
        stroke="currentColor"
        stroke-width="1.5"
        aria-hidden="true"
      >
        <rect x="4" y="5" width="16" height="15" rx="2" />
        <path d="M8 3v4M16 3v4M4 10h16" />
      </svg>
    </a>

  </div>

</div>