---
const features = [
  {
    title: "Quick Confirmation",
    description: "Get instant confirmation on your booking.",
    icon: `
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.35">
        <circle cx="12" cy="12" r="8.5"/>
        <path d="M12 7v5l3.2 2"/>
      </svg>
    `,
  },
  {
    title: "Easy Reservations",
    description: "Book in just a few clicks. Anytime, anywhere.",
    icon: `
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.35">
        <rect x="4" y="5.5" width="16" height="15" rx="2"/>
        <path d="M8 3v5M16 3v5M4 10h16"/>
        <path d="M9 15h.01M12 15h.01M15 15h.01M9 18h.01M12 18h.01"/>
      </svg>
    `,
  },
  {
    title: "Personal Assistance",
    description: "Need help? Our team is here for you.",
    icon: `
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.35">
        <path d="M4.5 13.5v-2a7.5 7.5 0 0 1 15 0v2"/>
        <path d="M4.5 13.5H7a1.5 1.5 0 0 1 1.5 1.5v3A1.5 1.5 0 0 1 7 19.5H6a1.5 1.5 0 0 1-1.5-1.5v-4.5Z"/>
        <path d="M19.5 13.5H17a1.5 1.5 0 0 0-1.5 1.5v3a1.5 1.5 0 0 0 1.5 1.5h1a1.5 1.5 0 0 0 1.5-1.5v-4.5Z"/>
        <path d="M19.5 18c0 1.4-1.2 2.5-2.7 2.5h-1.6"/>
      </svg>
    `,
  },
];
---

<section
  id="reservation"
  class="relative overflow-hidden bg-[#f2f2e8] px-5 py-20 sm:px-8 sm:py-24 lg:px-12 lg:py-28"
>
  <!-- ============================================================
       BACKGROUND
       ============================================================ -->

  <div
    class="pointer-events-none absolute inset-0 opacity-60"
    aria-hidden="true"
  >
    <div
      class="absolute left-1/2 top-0 h-[500px] w-[800px] -translate-x-1/2 rounded-full bg-[#d8dcc1]/30 blur-[120px]"
    ></div>

    <div
      class="absolute bottom-0 right-0 h-[350px] w-[350px] rounded-full bg-[#dfe1cf]/40 blur-[100px]"
    ></div>
  </div>

  <div class="relative z-10 mx-auto max-w-[1380px]">

    <!-- ==========================================================
         SECTION HEADER
         ========================================================== -->

    <header
      data-reveal
      class="mx-auto max-w-3xl text-center"
    >
      <!-- Eyebrow -->

      <div
        class="mb-5 flex items-center justify-center gap-3 text-[#687143]"
      >
        <svg
          viewBox="0 0 24 24"
          class="h-6 w-6"
          fill="none"
          stroke="currentColor"
          stroke-width="1.25"
          aria-hidden="true"
        >
          <path d="M12 21V8" />
          <path d="M12 12C8.5 12 6 9.5 6 6c3.5 0 6 2.5 6 6Z" />
          <path d="M12 15c3.5 0 6-2.5 6-9-3.5 0-6 2.5-6 9Z" />
          <path d="M12 8c0-2.7 1.6-5 4-6 0 3-1.6 5.2-4 6Z" />
        </svg>

        <span
          class="text-[13px] font-medium uppercase tracking-[0.18em]"
        >
          Reservation
        </span>
      </div>

      <!-- Heading -->

      <h2
        class="font-serif text-[48px] leading-[0.98] tracking-[-0.035em] text-[#151710] sm:text-[60px] lg:text-[68px]"
      >
        Your table is
        <span class="text-[#747d4e]">waiting.</span>
      </h2>

      <!-- Decorative divider -->

      <div class="my-7 flex items-center justify-center gap-5">
        <span class="h-px w-14 bg-[#7a815b]/60"></span>

        <svg
          viewBox="0 0 24 24"
          class="h-5 w-5 text-[#7a815b]"
          fill="none"
          stroke="currentColor"
          stroke-width="1.25"
          aria-hidden="true"
        >
          <path d="M12 21V8" />
          <path d="M12 12C8.5 12 6 9.5 6 6c3.5 0 6 2.5 6 6Z" />
          <path d="M12 15c3.5 0 6-2.5 6-9-3.5 0-6 2.5-6 6Z" />
        </svg>

        <span class="h-px w-14 bg-[#7a815b]/60"></span>
      </div>

      <p
        class="mx-auto max-w-xl text-[17px] leading-7 text-[#5f6159] sm:text-[20px] sm:leading-8"
      >
        Choose your preferred outlet, date and time.<br class="hidden sm:block" />
        We'll take care of the rest.
      </p>
    </header>


    <!-- ==========================================================
         RESERVATION CARD
         ========================================================== -->

    <div
      data-reveal
      data-delay="100"
      class="mt-12 overflow-hidden rounded-[24px] bg-white/70 shadow-[0_25px_80px_rgba(48,51,30,0.10)] ring-1 ring-black/[0.035] lg:mt-14 lg:grid lg:grid-cols-[0.94fr_1.12fr]"
    >

      <!-- ========================================================
           LEFT IMAGE
           ======================================================== -->

      <div
        class="relative min-h-[430px] overflow-hidden sm:min-h-[500px] lg:min-h-[570px]"
      >
        <!-- IMAGE PLACEHOLDER
             Replace this div with your image later -->

        <div
          class="absolute inset-0 bg-[#343728]"
        >
          <div
            class="absolute inset-0 bg-[radial-gradient(circle_at_50%_35%,rgba(170,170,120,.15),transparent_45%)]"
          ></div>

          <div
            class="absolute inset-0 flex items-center justify-center"
          >
            <img src="https://plus.unsplash.com/premium_photo-1661883237884-263e8de8869b?q=80&w=1189&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" alt="Elegant Forest Paradise dining table" class="absolute inset-0 h-full w-full object-cover">
          </div>
        </div>

        <!-- When you add your image, use:
        <img
          src="/images/reservation.jpg"
          alt="Elegant Forest Paradise dining table"
          class="absolute inset-0 h-full w-full object-cover"
        />
        -->

        <!-- Dark cinematic overlay -->

        <div
          class="absolute inset-0 bg-gradient-to-t from-black/75 via-black/10 to-black/10"
        ></div>

        <!-- Quote -->

        <div
          class="absolute bottom-9 left-8 right-8 text-white sm:bottom-10 sm:left-10 sm:right-10"
        >
          <!-- Quote marks -->

          <div
            class="mb-1 font-serif text-[50px] leading-none text-[#8b945d]"
          >
            “
          </div>

          <p
            class="max-w-md font-serif text-[23px] leading-[1.22] tracking-[-0.015em] sm:text-[25px]"
          >
            Good food brings people together.<br />
            We'll save the perfect spot for you.
          </p>

          <!-- Author -->

          <div class="mt-5 flex items-center gap-3">
            <span class="h-px w-10 bg-[#b5b887]/70"></span>

            <span
              class="text-[12px] font-medium uppercase tracking-[0.16em] text-[#b9bd87]"
            >
              Foresto Paradise
            </span>
          </div>
        </div>
      </div>


      <!-- ========================================================
           RIGHT FORM
           ======================================================== -->

      <div
        class="relative bg-white/65 px-6 py-9 sm:px-10 sm:py-11 lg:px-14 lg:py-10"
      >

        <!-- subtle glass highlight -->

        <div
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(circle_at_80%_0%,rgba(255,255,255,.85),transparent_40%)]"
        ></div>

        <div class="relative">

          <!-- Form heading -->

          <div class="mb-7">
            <h3
              class="font-serif text-[31px] leading-none tracking-[-0.025em] text-[#171912] sm:text-[34px]"
            >
              Book a Table
            </h3>

            <p class="mt-3 text-[15px] leading-6 text-[#6a6b64] sm:text-[16px]">
              Fill in the details below and we will confirm your reservation.
            </p>
          </div>


          <!-- ====================================================
               FORM
               ==================================================== -->

          <form
            class="space-y-5"
            action="#"
            method="post"
          >

            <!-- Outlet + Date -->

            <div class="grid gap-5 sm:grid-cols-2">

              <!-- Outlet -->

              <label class="block">
                <span class="mb-2 block text-[15px] font-medium text-[#66675f]">
                  Select Outlet
                </span>

                <div class="relative">
                  <select
                    name="outlet"
                    class="h-[56px] w-full appearance-none rounded-[13px] border border-[#d9d9cf] bg-white/40 pl-12 pr-10 text-[15px] text-[#24261e] outline-none transition-all duration-300 hover:border-[#a9ad8a] focus:border-[#7b844e] focus:bg-white/70 focus:ring-4 focus:ring-[#89925b]/10"
                  >
                    <option>Patliputra, Patna</option>
                    <option>Boring Road, Patna</option>
                    <option>Fraser Road, Patna</option>
                  </select>

                  <!-- location icon -->

                  <svg
                    viewBox="0 0 24 24"
                    class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-[#737c50]"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path d="M20 10.5c0 5.5-8 10-8 10s-8-4.5-8-10a8 8 0 1 1 16 0Z" />
                    <circle cx="12" cy="10.5" r="2.5" />
                  </svg>

                  <!-- chevron -->

                  <svg
                    viewBox="0 0 24 24"
                    class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[#72755f]"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </div>
              </label>


              <!-- Date -->

              <label class="block">
                <span class="mb-2 block text-[15px] font-medium text-[#66675f]">
                  Date
                </span>

                <div class="relative">
                  <input
                    type="date"
                    name="date"
                    value="2025-05-31"
                    class="h-[56px] w-full rounded-[13px] border border-[#d9d9cf] bg-white/40 px-12 text-[15px] text-[#24261e] outline-none transition-all duration-300 hover:border-[#a9ad8a] focus:border-[#7b844e] focus:bg-white/70 focus:ring-4 focus:ring-[#89925b]/10"
                  />

                  <svg
                    viewBox="0 0 24 24"
                    class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-[#737c50]"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <rect x="4" y="5" width="16" height="15" rx="2" />
                    <path d="M8 3v4M16 3v4M4 10h16" />
                  </svg>
                </div>
              </label>

            </div>


            <!-- Guests + Time -->

            <div class="grid gap-5 sm:grid-cols-2">

              <!-- Guests -->

              <label class="block">
                <span class="mb-2 block text-[15px] font-medium text-[#66675f]">
                  Guests
                </span>

                <div class="relative">
                  <select
                    name="guests"
                    class="h-[56px] w-full appearance-none rounded-[13px] border border-[#d9d9cf] bg-white/40 pl-12 pr-10 text-[15px] text-[#24261e] outline-none transition-all duration-300 hover:border-[#a9ad8a] focus:border-[#7b844e] focus:bg-white/70 focus:ring-4 focus:ring-[#89925b]/10"
                  >
                    <option>2 Guests</option>
                    <option>3 Guests</option>
                    <option>4 Guests</option>
                    <option>5 Guests</option>
                    <option>6 Guests</option>
                    <option>7+ Guests</option>
                  </select>

                  <svg
                    viewBox="0 0 24 24"
                    class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-[#737c50]"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path d="M16 20v-1.5a4 4 0 0 0-4-4H7a4 4 0 0 0-4 4V20" />
                    <circle cx="9.5" cy="7.5" r="3.5" />
                    <path d="M17 11a3.5 3.5 0 1 0 0-7" />
                    <path d="M21 20v-1.5a4 4 0 0 0-3-3.87" />
                  </svg>

                  <svg
                    viewBox="0 0 24 24"
                    class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[#72755f]"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </div>
              </label>


              <!-- Time -->

              <label class="block">
                <span class="mb-2 block text-[15px] font-medium text-[#66675f]">
                  Time
                </span>

                <div class="relative">
                  <select
                    name="time"
                    class="h-[56px] w-full appearance-none rounded-[13px] border border-[#d9d9cf] bg-white/40 pl-12 pr-10 text-[15px] text-[#24261e] outline-none transition-all duration-300 hover:border-[#a9ad8a] focus:border-[#7b844e] focus:bg-white/70 focus:ring-4 focus:ring-[#89925b]/10"
                  >
                    <option>8:00 PM</option>
                    <option>7:00 PM</option>
                    <option>7:30 PM</option>
                    <option>8:30 PM</option>
                    <option>9:00 PM</option>
                    <option>9:30 PM</option>
                  </select>

                  <svg
                    viewBox="0 0 24 24"
                    class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-[#737c50]"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <circle cx="12" cy="12" r="8.5" />
                    <path d="M12 7v5l3 2" />
                  </svg>

                  <svg
                    viewBox="0 0 24 24"
                    class="pointer-events-none absolute right-4 top-1/2 h-4 w-4 -translate-y-1/2 text-[#72755f]"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.5"
                  >
                    <path d="m6 9 6 6 6-6" />
                  </svg>
                </div>
              </label>

            </div>


            <!-- Special Request -->

            <label class="block">
              <span class="mb-2 block text-[15px] font-medium text-[#66675f]">
                Special Request <span class="font-normal">(Optional)</span>
              </span>

              <div class="relative">
                <input
                  type="text"
                  name="request"
                  placeholder="Any special request or preferences?"
                  class="h-[56px] w-full rounded-[13px] border border-[#d9d9cf] bg-white/40 pl-12 pr-4 text-[15px] text-[#24261e] placeholder:text-[#777970] outline-none transition-all duration-300 hover:border-[#a9ad8a] focus:border-[#7b844e] focus:bg-white/70 focus:ring-4 focus:ring-[#89925b]/10"
                />

                <svg
                  viewBox="0 0 24 24"
                  class="pointer-events-none absolute left-4 top-1/2 h-5 w-5 -translate-y-1/2 text-[#737c50]"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.5"
                >
                  <path d="m14 6 4 4" />
                  <path d="M4 20l4.2-1 9.1-9.1a2.8 2.8 0 0 0-4-4L4.2 15Z" />
                  <path d="m13 7 4 4" />
                </svg>
              </div>
            </label>


            <!-- Reserve Button -->

            <button
              type="submit"
              class="group mt-1 flex h-[58px] w-full items-center justify-center gap-6 rounded-full bg-[#747d4e] px-8 text-[17px] font-medium text-white shadow-[0_10px_30px_rgba(91,99,57,0.18)] transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#687142] hover:shadow-[0_15px_35px_rgba(91,99,57,0.25)] active:translate-y-0"
            >
              <span>Reserve a Table</span>

              <svg
                viewBox="0 0 24 24"
                class="h-5 w-5 transition-transform duration-300 group-hover:translate-x-1.5"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
              >
                <path d="M5 12h14" />
                <path d="m13 6 6 6-6 6" />
              </svg>
            </button>


            <!-- Trust -->

            <div
              class="flex items-center justify-center gap-3 pt-1 text-[14px] text-[#595c53]"
            >
              <svg
                viewBox="0 0 24 24"
                class="h-5 w-5 text-[#75804f]"
                fill="none"
                stroke="currentColor"
                stroke-width="1.4"
              >
                <path d="M12 3 19 6v5c0 4.5-2.9 7.8-7 9-4.1-1.2-7-4.5-7-9V6l7-3Z" />
                <path d="m9 12 2 2 4-4" />
              </svg>

              <span>Instant confirmation</span>

              <span class="text-[#888b80]">•</span>

              <span>No booking fees</span>
            </div>

          </form>
        </div>
      </div>
    </div>


    <!-- ==========================================================
         BENEFITS
         ========================================================== -->

    <div
      data-reveal
      data-delay="200"
      class="mx-auto mt-12 grid max-w-[1050px] divide-y divide-[#d4d5ca] border-t border-[#d4d5ca] sm:grid-cols-3 sm:divide-x sm:divide-y-0 sm:border-t-0"
    >

      {features.map((feature) => (
        <div
          class="flex gap-5 px-5 py-7 sm:px-8 sm:py-2 lg:px-10"
        >
          <div
            class="flex h-12 w-12 shrink-0 items-center justify-center rounded-full text-[#788252]"
          >
            <Fragment set:html={feature.icon} />
          </div>

          <div>
            <h4
              class="font-serif text-[18px] leading-tight text-[#191b15]"
            >
              {feature.title}
            </h4>

            <p
              class="mt-2 max-w-[220px] text-[14px] leading-6 text-[#5e6059]"
            >
              {feature.description}
            </p>
          </div>
        </div>
      ))}

    </div>

  </div>
</section>


<!-- ==============================================================
     REVEAL ANIMATION
     ============================================================== -->

<script>
  const revealElements = document.querySelectorAll<HTMLElement>("[data-reveal]");

  if (revealElements.length) {
    const observer = new IntersectionObserver(
      (entries, observer) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          const element = entry.target as HTMLElement;
          const delay = element.dataset.delay ?? "0";

          element.style.transitionDelay = `${delay}ms`;
          element.classList.add("is-visible");

          observer.unobserve(element);
        });
      },
      {
        threshold: 0.12,
        rootMargin: "0px 0px -60px 0px",
      }
    );

    revealElements.forEach((element) => {
      observer.observe(element);
    });
  }
</script>


<style>
  /*
   * Serif typography.
   *
   * This assumes your global project already defines a serif font.
   * If not, replace `font-serif` with your preferred font family.
   */

  [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 900ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  /*
   * Make native date input icon less visually dominant.
   */

  input[type="date"]::-webkit-calendar-picker-indicator {
    opacity: 0;
    position: absolute;
    right: 0;
    width: 100%;
    height: 100%;
    cursor: pointer;
  }

  /*
   * Prevent ugly horizontal overflow on small screens.
   */

  section {
    overflow-x: clip;
  }

  /*
   * Respect users who prefer reduced motion.
   */

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>