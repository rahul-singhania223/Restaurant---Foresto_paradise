---
import { Image } from "astro:assets";

const dishes = [
  {
    category: "STARTERS",
    name: "Smoky Paneer Tikka",
    description:
      "Cottage cheese marinated with aromatic spices and grilled to perfection.",
    price: "₹349",
    image: "https://images.unsplash.com/photo-1666001120694-3ebe8fd207be?q=80&w=1170&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
  },
  {
    category: "MAINS",
    name: "Butter Chicken",
    description:
      "Classic recipe with rich, buttery tomato gravy.",
    price: "₹399",
    image: "https://plus.unsplash.com/premium_photo-1661419883163-bb4df1c10109?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
  },
  {
    category: "MAINS",
    name: "Signature Biryani",
    description:
      "Fragrant basmati rice cooked with aromatic spices and herbs.",
    price: "₹429",
    image: "https://images.unsplash.com/photo-1705174299330-939dd03cc864?q=80&w=687&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
  },
  {
    category: "DESSERTS",
    name: "Chocolate Lava Cake",
    description:
      "Warm chocolate cake with a molten chocolate center.",
    price: "₹279",
    image: "https://images.unsplash.com/photo-1606890737304-57a1ca8a5b62?q=80&w=803&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D",
  },
];

const highlights = [
  {
    title: "Fresh Ingredients",
    description: "Sourced with care",
    icon: "leaf",
  },
  {
    title: "Authentic Flavours",
    description: "True to tradition",
    icon: "pot",
  },
  {
    title: "Made with Love",
    description: "In every dish",
    icon: "heart",
  },
  {
    title: "Beautifully Served",
    description: "For your moments",
    icon: "leaves",
  },
];
---

<section
  id="menu"
  class="signature-menu relative isolate overflow-hidden bg-contain bg-center text-[#1d2117]"
>
  <!-- ============================================================
       BACKGROUND
       Replace this image with your actual section background.
       ============================================================ -->

  <div class="pointer-events-none absolute inset-0 ">
    <img
      src="/images/menu-background.png"
      alt=""
      class="h-full w-full object-cover opacity-100"
      loading="lazy"
    />

    <!-- Soft cream overlay -->
    <div
      class="absolute inset-0 bg-[#f1f1df]/75"
    ></div>

    <!-- Soft atmospheric gradients -->
    <div
      class="absolute inset-0 bg-[radial-gradient(circle_at_50%_20%,rgba(255,255,255,0.8),transparent_42%),linear-gradient(to_bottom,rgba(245,245,228,0.35),rgba(235,235,211,0.75))]"
    ></div>
  </div>


  <!-- ============================================================
       DECORATIVE LEAVES
       ============================================================ -->

  <div
    class="pointer-events-none absolute -left-10 top-0 -z-10 hidden w-48 opacity-45 sm:block lg:w-64"
  >
    <img
      src="/images/menu/leaf-left.png"
      alt=""
      class="menu-leaf menu-leaf-left w-full"
      loading="lazy"
    />
  </div>

  <div
    class="pointer-events-none absolute -right-8 top-[20%] -z-10 hidden w-44 opacity-45 sm:block lg:w-60"
  >
    <img
      src="/images/menu/leaf-right.png"
      alt=""
      class="menu-leaf menu-leaf-right w-full"
      loading="lazy"
    />
  </div>


  <!-- ============================================================
       MAIN CONTAINER
       ============================================================ -->

  <div
    class="mx-auto max-w-[1500px] px-5 py-20 sm:px-8 sm:py-24 lg:px-12 lg:py-28 xl:px-16"
  >

    <!-- ==========================================================
         HEADER
         ========================================================== -->

    <div class="mx-auto max-w-3xl text-center">

      <!-- Eyebrow -->
      <div
        data-reveal
        class="flex items-center justify-center gap-2 text-[11px] font-medium uppercase tracking-[0.2em] text-[#697342] sm:text-xs"
      >
        <!-- Leaf icon -->
        <svg
          viewBox="0 0 24 24"
          class="h-4 w-4"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="M12 21V8" />
          <path
            d="M12 12C8.5 12 6 9.5 6 6c3.5 0 6 2.5 6 6Z"
          />
          <path
            d="M12 15c3.5 0 6-2.5 6-9-3.5 0-6 2.5-6 6Z"
          />
        </svg>

        <span>Signature Menu</span>
      </div>


      <!-- Heading -->
      <h2
        data-reveal
        data-delay="100"
        class="mt-5 font-serif text-[clamp(3rem,6vw,5.7rem)] font-normal leading-[0.94] tracking-[-0.045em]"
      >
        Crafted with care.
        <span class="block text-[#77834e]">
          Made to be remembered.
        </span>
      </h2>


      <!-- Decorative underline -->
      <div
        data-reveal
        data-delay="150"
        class="mt-3 flex items-center justify-center"
      >
        <svg
          viewBox="0 0 100 20"
          class="h-5 w-28 text-[#a1aa70] sm:w-32"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M50 17C54 11 61 7 70 6C79 5 87 7 94 10"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linecap="round"
          />
          <path
            d="M50 17C46 11 39 7 30 6C21 5 13 7 6 10"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linecap="round"
          />
          <path
            d="M50 17C49 11 49 6 50 2"
            stroke="currentColor"
            stroke-width="1.2"
            stroke-linecap="round"
          />
        </svg>
      </div>


      <!-- Description -->
      <p
        data-reveal
        data-delay="200"
        class="mx-auto mt-6 max-w-2xl text-sm leading-7 text-[#4f5548] sm:text-base sm:leading-7"
      >
        Explore our chef's handpicked favourites, made with
        <br class="hidden sm:block" />
        the finest ingredients and a lot of heart.
      </p>


      <!-- CTA -->
      <div
        data-reveal
        data-delay="300"
        class="mt-7 flex justify-center"
      >
        <a
          href="/menu"
          class="group inline-flex items-center gap-5 rounded-full bg-[#788548] px-7 py-3.5 text-sm font-medium text-white shadow-[0_12px_30px_rgba(84,96,48,0.18)] transition-all duration-500 hover:-translate-y-0.5 hover:bg-[#68763d] hover:shadow-[0_16px_35px_rgba(84,96,48,0.25)] sm:px-8 sm:py-4 sm:text-base"
        >
          <span>Explore Full Menu</span>

          <svg
            viewBox="0 0 24 24"
            class="h-5 w-5 transition-transform duration-500 group-hover:translate-x-1"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            aria-hidden="true"
          >
            <path d="M5 12h13" />
            <path d="m13 7 5 5-5 5" />
          </svg>
        </a>
      </div>
    </div>


    <!-- ==========================================================
         DISH CARDS
         ========================================================== -->

    <div
      class="mt-14 grid grid-cols-1 gap-5 sm:mt-16 sm:grid-cols-2 lg:mt-20 lg:grid-cols-4 lg:gap-6"
    >

      {
        dishes.map((dish, index) => (
          <article
            data-reveal
            data-delay={String(400 + index * 100)}
            class="menu-card group overflow-hidden rounded-[20px] border border-[#d7d8c5] bg-[#f7f7e9]/90 shadow-[0_10px_30px_rgba(48,53,30,0.05)] backdrop-blur-sm transition-all duration-500 hover:-translate-y-1 hover:shadow-[0_20px_45px_rgba(48,53,30,0.12)]"
          >

            <!-- Image -->
            <div class="relative aspect-[1.15/1] overflow-hidden">

             <Image
                src={dish.image}
                alt={dish.name}
                class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.045]"
                loading="lazy"
                width={600}
                height={600}
              />
              <!-- Image overlay -->
              <div
                class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/10 via-transparent to-white/10"
              ></div>


              <!-- Small leaf badge -->
              <div
                class="absolute right-4 top-4 flex h-11 w-11 items-center justify-center rounded-full border border-[#d9dcc7]/80 bg-[#f8f8eb]/90 text-[#778548] shadow-[0_5px_20px_rgba(0,0,0,0.08)] backdrop-blur-md transition-transform duration-500 group-hover:rotate-6"
              >
                <svg
                  viewBox="0 0 24 24"
                  class="h-5 w-5"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.35"
                  aria-hidden="true"
                >
                  <path d="M12 21V8" />
                  <path
                    d="M12 12C8.5 12 6 9.5 6 6c3.5 0 6 2.5 6 6Z"
                  />
                  <path
                    d="M12 15c3.5 0 6-2.5 6-9-3.5 0-6 2.5-6 6Z"
                  />
                </svg>
              </div>
            </div>


            <!-- Card Content -->
            <div class="flex min-h-[205px] flex-col px-6 pb-5 pt-5 sm:px-5 lg:px-6">

              <p
                class="text-[11px] font-medium uppercase tracking-[0.12em] text-[#6e7947]"
              >
                {dish.category}
              </p>

              <h3
                class="mt-3 font-serif text-[23px] leading-tight tracking-[-0.025em] text-[#20231b]"
              >
                {dish.name}
              </h3>

              <p
                class="mt-3 max-w-[280px] text-sm leading-6 text-[#575b51]"
              >
                {dish.description}
              </p>


              <!-- Price + Add -->
              <div class="mt-auto flex items-center justify-between pt-5">

                <div class="flex items-center gap-2.5">
                  <span
                    class="text-[20px] font-medium tracking-[-0.02em] text-[#1f221b]"
                  >
                    {dish.price}
                  </span>

                  <svg
                    viewBox="0 0 24 24"
                    class="h-4 w-4 text-[#778548]"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.35"
                    aria-hidden="true"
                  >
                    <path d="M12 21V8" />
                    <path
                      d="M12 12C8.5 12 6 9.5 6 6c3.5 0 6 2.5 6 6Z"
                    />
                    <path
                      d="M12 15c3.5 0 6-2.5 6-9-3.5 0-6 2.5-6 6Z"
                    />
                  </svg>
                </div>


                

              </div>
            </div>
          </article>
        ))
      }
    </div>


    <!-- ==========================================================
         HIGHLIGHTS
         ========================================================== -->

    <div
      data-reveal
      data-delay="850"
      class="mt-10 border-t border-[#d5d7c4] pt-8 sm:mt-12 sm:pt-9 lg:mt-8"
    >

      <div
        class="grid grid-cols-2 divide-x divide-y divide-[#d5d7c4] lg:grid-cols-4 lg:divide-y-0"
      >

        {
          highlights.map((item, index) => (
            <div
              class:list={[
                "flex items-center gap-4 px-4 py-5 sm:px-6 lg:justify-center lg:px-8",
                index === 0 && "lg:pl-0",
                index === highlights.length - 1 && "lg:pr-0",
              ]}
            >

              <!-- Icon -->
              <div class="shrink-0 text-[#778548]">

                {item.icon === "leaf" && (
                  <svg
                    viewBox="0 0 24 24"
                    class="h-9 w-9"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.2"
                    aria-hidden="true"
                  >
                    <path d="M12 21V8" />
                    <path d="M12 12C8 12 5 9 5 5c4 0 7 3 7 7Z" />
                    <path d="M12 17c4 0 7-3 7-7-4 0-7 3-7 7Z" />
                  </svg>
                )}

                {item.icon === "pot" && (
                  <svg
                    viewBox="0 0 24 24"
                    class="h-9 w-9"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.2"
                    aria-hidden="true"
                  >
                    <path d="M6 10h12v7a3 3 0 0 1-3 3H9a3 3 0 0 1-3-3v-7Z" />
                    <path d="M4 10h16" />
                    <path d="M9 7c0-1.5 1-2 1-3" />
                    <path d="M13 7c0-1.5 1-2 1-3" />
                    <path d="M3 20h18" />
                  </svg>
                )}

                {item.icon === "heart" && (
                  <svg
                    viewBox="0 0 24 24"
                    class="h-9 w-9"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.2"
                    aria-hidden="true"
                  >
                    <path
                      d="M20.8 8.8c0 5.5-8.8 10.2-8.8 10.2S3.2 14.3 3.2 8.8A4.6 4.6 0 0 1 12 6.3a4.6 4.6 0 0 1 8.8 2.5Z"
                    />
                  </svg>
                )}

                {item.icon === "leaves" && (
                  <svg
                    viewBox="0 0 24 24"
                    class="h-9 w-9"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.2"
                    aria-hidden="true"
                  >
                    <path d="M12 22V10" />
                    <path
                      d="M12 13C7.5 13 5 10 5 6c4.5 0 7 3 7 7Z"
                    />
                    <path
                      d="M12 17c4.5 0 7-3 7-8-4.5 0-7 3-7 8Z"
                    />
                    <path
                      d="M8 19c-2.5 0-4.5-1.5-5-4 2.5 0 4.5 1.5 5 4Z"
                    />
                  </svg>
                )}

              </div>


              <!-- Text -->
              <div>
                <p
                  class="font-serif text-base leading-tight text-[#292c22] sm:text-[17px]"
                >
                  {item.title}
                </p>

                <p
                  class="mt-1 text-xs text-[#686c61] sm:text-sm"
                >
                  {item.description}
                </p>
              </div>

            </div>
          ))
        }

      </div>
    </div>

  </div>
</section>


<!-- ================================================================
     ANIMATION
     ================================================================ -->

<script>
  const revealElements = document.querySelectorAll<HTMLElement>("[data-reveal]");

  if (
    "IntersectionObserver" in window &&
    !window.matchMedia("(prefers-reduced-motion: reduce)").matches
  ) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;

          const element = entry.target as HTMLElement;
          const delay = element.dataset.delay ?? "0";

          element.style.setProperty("--reveal-delay", `${delay}ms`);
          element.classList.add("is-visible");

          observer.unobserve(element);
        });
      },
      {
        threshold: 0.12,
        rootMargin: "0px 0px -60px 0px",
      },
    );

    revealElements.forEach((element) => observer.observe(element));
  } else {
    revealElements.forEach((element) => {
      element.classList.add("is-visible");
    });
  }
</script>


<style>
  /* ============================================================
     SCROLL REVEAL
     ============================================================ */

  [data-reveal] {
    opacity: 0;
    transform: translateY(28px);
    transition:
      opacity 900ms cubic-bezier(0.22, 1, 0.36, 1),
      transform 900ms cubic-bezier(0.22, 1, 0.36, 1);
    transition-delay: var(--reveal-delay, 0ms);
  }

  [data-reveal].is-visible {
    opacity: 1;
    transform: translateY(0);
  }


  /* ============================================================
     BACKGROUND LEAF MOVEMENT
     ============================================================ */

  .menu-leaf {
    animation: leaf-float 9s ease-in-out infinite;
    transform-origin: center;
  }

  .menu-leaf-right {
    animation-delay: -3s;
  }

  @keyframes leaf-float {
    0%,
    100% {
      transform: translate3d(0, 0, 0) rotate(0deg);
    }

    50% {
      transform: translate3d(0, 10px, 0) rotate(1.5deg);
    }
  }


  /* ============================================================
     CARD IMAGE
     ============================================================ */

  .menu-card {
    transform: translateZ(0);
    backface-visibility: hidden;
  }


  /* ============================================================
     MOBILE
     ============================================================ */

  @media (max-width: 640px) {
    [data-reveal] {
      transform: translateY(20px);
    }

    .signature-menu {
      overflow: hidden;
    }
  }


  /* ============================================================
     REDUCED MOTION
     ============================================================ */

  @media (prefers-reduced-motion: reduce) {
    [data-reveal] {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .menu-leaf {
      animation: none;
    }

    .menu-card,
    .menu-card img {
      transition: none;
    }
  }
</style>